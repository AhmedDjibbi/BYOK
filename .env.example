MONGODB_URI=mongodb://127.0.0.1:27017/byok
PORT=3000
ADMIN_API_TOKEN=
TRUST_PROXY=
BACKUP_DIR=backups

# Optional: point the Vite dev proxy at a different API origin.
VITE_API_PROXY_TARGET=

# Store rules. SHIPPING_MODE is fixed or percentage; SHIPPING_VALUE is TND or %.
SHIPPING_MODE=fixed
SHIPPING_VALUE=0
SHIPPING_CURRENCY=TND
PENDING_ORDER_TTL_HOURS=72
LOW_STOCK_THRESHOLD=5

# Phase 9: shared rate-limit store.
REDIS_URL=

# Staff token rotation and cross-origin access.
ADMIN_API_TOKENS=
ALLOWED_ORIGINS=

# Configure both notification channels with real provider credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFICATION_SMS_TO=
